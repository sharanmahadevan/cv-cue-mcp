# Arista CV-CUE MCP — copy to .env and fill in.
#
# API base URL: CV-CUE → System → Advanced Settings → "Base URLs for APIs",
# e.g. https://awmXXXXX-c4.srv.wifi.arista.com/wifi/api
# Leave empty with an API key to auto-discover it from Launchpad.
CVCUE_BASE_URL=

# Cloud: API key from Launchpad → Admin → Keys
CVCUE_KEY_ID=
CVCUE_KEY_VALUE=

# On-premises alternative: local CV-CUE user
# CVCUE_USERNAME=
# CVCUE_PASSWORD=

# Only if the key can access more than one customer
# CVCUE_CID=

# Allow mutating calls (reboot, disconnect, PUT/POST/DELETE via cvcue_api_execute)
CVCUE_ENABLE_WRITES=false
# CVCUE_VERIFY_SSL=true
